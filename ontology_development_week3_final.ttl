###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/transportedVia
ns11:transportedVia rdf:type owl:ObjectProperty ;
                    rdfs:domain ns11:Tool_Group ;
                    rdfs:range ns11:Transport .



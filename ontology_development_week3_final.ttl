ns11:releasesLot rdf:type owl:ObjectProperty ;
                 rdfs:domain ns11:Product ;
                 rdfs:range ns11:Lot .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/requiresSetup
ns11:requiresSetup rdf:type owl:ObjectProperty ;
                   rdfs:domain ns11:Process_Step ;
                   rdfs:range ns11:Setup .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/requiresToolGroup
ns11:requiresToolGroup rdf:type owl:ObjectProperty ;

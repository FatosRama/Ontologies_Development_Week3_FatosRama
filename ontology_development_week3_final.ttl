@prefix : <http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3#> .
@prefix ns1: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ns11: <http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3> .

<http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/ontology#belongsToToolGroup
ns1:belongsToToolGroup rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#constrainedStep
ns1:constrainedStep rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#distributionType
ns1:distributionType rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#fromLocation
ns1:fromLocation rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#hasPriority
ns1:hasPriority rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#hasRoute
ns1:hasRoute rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#hasWafersPerLot
ns1:hasWafersPerLot rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#isReleasedForProduct
ns1:isReleasedForProduct rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#isSuperHotLot
ns1:isSuperHotLot rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#maxQueueTime
ns1:maxQueueTime rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#meanTransportTime
ns1:meanTransportTime rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#offsetTransportTime
ns1:offsetTransportTime rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#releasesLot
ns1:releasesLot rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#targetStep
ns1:targetStep rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#timeUnit
ns1:timeUnit rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#toLocation
ns1:toLocation rdf:type owl:AnnotationProperty .


###  http://example.org/ontology#transportedVia
ns1:transportedVia rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/nextStep
ns11:nextStep rdf:type owl:AnnotationProperty ;
              rdfs:range ns11:Process_Step .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/requiresToolGroup
ns11:requiresToolGroup rdf:type owl:AnnotationProperty ;
                       rdfs:range ns11:Tool_Group .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/belongsToSetupGroup
ns11:belongsToSetupGroup rdf:type owl:ObjectProperty ;
                         rdfs:domain ns11:Tool_Group ;
                         rdfs:range ns11:Setup_Group .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/belongsToToolGroup
ns11:belongsToToolGroup rdf:type owl:ObjectProperty ;
                        rdfs:domain ns11:Tool ;
                        rdfs:range ns11:Tool_Group .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/consistsOfLot
ns11:consistsOfLot rdf:type owl:ObjectProperty ;
                   rdfs:domain ns11:Batch ;
                   rdfs:range ns11:Lot .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/consistsOfStep
ns11:consistsOfStep rdf:type owl:ObjectProperty ;
                    rdfs:domain ns11:Route ;
                    rdfs:range ns11:Process_Step .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/formsBatch
ns11:formsBatch rdf:type owl:ObjectProperty ;
                rdfs:domain ns11:Process_Step ;
                rdfs:range ns11:Batch .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/hasCQTConstraint
ns11:hasCQTConstraint rdf:type owl:ObjectProperty ;
                      rdfs:domain ns11:Process_Step ;
                      rdfs:range ns11:Critical_Queue_Time .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/hasRoute
ns11:hasRoute rdf:type owl:ObjectProperty ;
              rdfs:domain ns11:Product ;
              rdfs:range ns11:Route .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/hasSamplingRate
ns11:hasSamplingRate rdf:type owl:ObjectProperty ;
                     rdfs:domain ns11:Process_Step ;
                     rdfs:range ns11:Sampling .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/hasSetup
ns11:hasSetup rdf:type owl:ObjectProperty ;
              rdfs:domain ns11:Tool_Group ;
              rdfs:range ns11:Setup .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/hasTool
ns11:hasTool rdf:type owl:ObjectProperty ;
             rdfs:domain ns11:Tool_Group ;
             rdfs:range ns11:Tool .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/nextStep

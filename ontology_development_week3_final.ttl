                   ns11:performedIn ns11:Def_Met ;
                   ns11:hasDownType "time based (calendar)" ;
                   ns11:hasFOA "10080.0"^^xsd:float ;
                   ns11:hasFOAUnits "min" ;
                   ns11:hasFirstOneAtDistribution "exponential" ;
                   ns11:hasMTTF "10080.0"^^xsd:float ;
                   ns11:hasMTTFUnits "min" ;
                   ns11:hasMTTR "35.28"^^xsd:float ;
                   ns11:hasMTTRUnits "min" ;
                   ns11:hasMeanTimeToFailure "10080.0"^^xsd:float ;
                   ns11:hasMeanTimeToRepair "35.28"^^xsd:float ;
                   ns11:hasTTFDistribution "exponential" ;
                   ns11:hasTTRDistribution "exponential" .



#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Area
ns11:Area rdf:type owl:Class ;
          dcterms:description "A functional manufacturing area (e.g. diffusion, litho, etch) that groups multiple toolgroups sharing similar characteristics and availability targets." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Batch
ns11:Batch rdf:type owl:Class ;
           dcterms:description "A group of lots (or wafers) processed together as a single unit on a batching tool, most notably in the diffusion area where a diffusion tube processes 100–150 wafers at once" .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Breakdown
ns11:Breakdown rdf:type owl:Class ;
               rdfs:subClassOf ns11:Downtime ;
               dcterms:description "A period during which a tool is unavailable for processing, split into scheduled (PM) and unscheduled (breakdown) downtime, balanced separately for each area." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Critical_Queue_Time
ns11:Critical_Queue_Time rdf:type owl:Class ;
                         dcterms:description "A time constraint (CQT) between two specific process steps" .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Downtime
ns11:Downtime rdf:type owl:Class ;
              dcterms:description "A period during which a tool is unavailable for processing, split into scheduled (PM) and unscheduled (breakdown) downtime, balanced separately for each area." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Hot_Lot
ns11:Hot_Lot rdf:type owl:Class ;
             rdfs:subClassOf ns11:Lot ;
             dcterms:description "A subclass of Lot with elevated dispatch priority, triggered by a change in demand; takes precedence over regular lots and can force setups." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Lot
ns11:Lot rdf:type owl:Class ;
         dcterms:description "A batch of wafers (typically 25) released into the fab for processing. Defined by wafers-per-lot, release interval, priority, and (where applicable) due date." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/PM
ns11:PM rdf:type owl:Class ;
        rdfs:subClassOf ns11:Downtime ;
        dcterms:description "A subclass of Downtime representing planned preventive maintenance — scheduled down time (SDT), triggered by time-based or usage/counter-based rules." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Process_Step
ns11:Process_Step rdf:type owl:Class ;
                  dcterms:description "A single manufacturing operation within a route —one row of a Route_Product table, tagged to an area, a toolgroup, a processing-time distribution, and optional setup/rework/sampling/CQT attributes." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Product
ns11:Product rdf:type owl:Class ;
             dcterms:description "A manufactured item type produced by the fab. Defined by which route its lots follow, its release pattern, and its raw processing time (RPT). The HVLM dataset models exactly two products." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Regular_Lot
ns11:Regular_Lot rdf:type owl:Class ;
                 rdfs:subClassOf ns11:Lot ;
                 dcterms:description "A subclass of Lot with standard (lowest) dispatch priority — the default lot type released at the fab's normal WSPW rate." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Route
ns11:Route rdf:type owl:Class ;
           dcterms:description "A manufacturing route represents the sequential sequence of manufacturing process steps (e.g., lithography, etching, cleaning, inspection) that a product or wafer lot undergoes inside the shop floor/fab." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Sampling
ns11:Sampling rdf:type owl:Class ;
              dcterms:description "The inspection policy attached to a process step, defined by a sampling rate  that determines the probability a given lot is measured/inspected at that step rather than passed straight through." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Setup
ns11:Setup rdf:type owl:Class ;
           dcterms:description "A changeover operation a tool must perform before processing a lot that requires a different recipe/operation. Defined by a setup group, current/new setup, setup time, and minimal run length before the next changeover is allowed." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Setup_Group
ns11:Setup_Group rdf:type owl:Class ;
                 rdfs:subClassOf ns11:Setup ;
                 dcterms:description "A subclass of Setup representing a full transition matrix of setup times between every pair of tool configurations, rather than a single current→new setup." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Super_Hot_Lot
ns11:Super_Hot_Lot rdf:type owl:Class ;
                   rdfs:subClassOf ns11:Lot ;
                   dcterms:description "A subclass of Lot with the highest dispatch priority; additionally reserves a tool for its next process step ahead of time (the superhotlot rule)." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Tool
ns11:Tool rdf:type owl:Class ;
          dcterms:description "A single physical machine belonging to a toolgroup; the individual unit subject to PM and breakdown events." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Tool_Group
ns11:Tool_Group rdf:type owl:Class ;
                dcterms:description "A set of interchangeable machines that can perform a given process step, sharing dispatching rules, loading/unloading times, and batching/cascading behavior." .


###  http://www.semanticweb.org/fatos/ontologies/2026/7/ontology_development_week3/Transport
ns11:Transport rdf:type owl:Class ;
               dcterms:description "The time required to move a lot between two toolgroup locations, modeled as a continuous uniform distribution (5–10 minutes in HVLM)." .


#################################################################
#    Individuals
#################################################################

###  http://example.org/ontology#WE_FE_85_unit_2
ns1:WE_FE_85_unit_2 rdf:type owl:NamedIndividual ,
                             ns11:Tool ;
                    ns11:belongsToToolGroup ns11:WE_FE_85 .



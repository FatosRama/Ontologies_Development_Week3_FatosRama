        <mxCell id="hnpdLIrYYvueMlUQwmrZ-467" parent="hnpdLIrYYvueMlUQwmrZ-466" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=24;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px;&quot;&gt;[2] Ferroelectric Memory Company (FMC), &lt;em&gt;Behind the Breakthrough — From Lab to Impact&lt;/em&gt;, White paper, 2025.&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="300" width="885" as="geometry">

        <mxCell id="hnpdLIrYYvueMlUQwmrZ-446" parent="hnpdLIrYYvueMlUQwmrZ-445" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=24;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px;&quot;&gt;&lt;div style=&quot;&quot;&gt;[1] Ferroelectric Memory Company (FMC), &quot;Technology,&quot; &lt;em&gt;ferroelectric-memory.com&lt;/em&gt;, Accessed: Aug. 5, 2026. [Online]. Available: &lt;a class=&quot;underline underline underline-offset-2 decoration-1 decoration-current/40 hover:decoration-current focus:decoration-current&quot; href=&quot;https://www.ferroelectric-memory.com/technology/&quot;&gt;https://www.ferroelectric-memory.com/technology/&lt;/a&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
